# Copy to .env and fill in real values for production
DRY_RUN=true
LIVE_MARKET=false
NODE_ENV=development
PORT=4000
DB_PATH=./data/amanah.sqlite
RULES_CONFIG_PATH=./rules.yaml
STABLECOIN_ASSET=USDC
BINANCE_PUBLIC_API=https://api.binance.com

# Required when DRY_RUN=false
BINANCE_MCP_URL=
AGENT_SUBACCOUNT_API_KEY=
AGENT_SUBACCOUNT_SECRET=

# Optional: real IPFS receipt pinning
# Use Pinata (recommended) or web3.storage classic API
# Leave both empty to use mock IPFS
PINATA_JWT=
WEB3_STORAGE_TOKEN=
